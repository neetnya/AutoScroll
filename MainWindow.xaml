<Window x:Class="AutoScroll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoScroll"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Icon="AutoScroll.ico"
        Width="220"
        SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border Background="#EE222831"
            BorderBrush="#FF00ADB5"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ToggleButton"
                        Grid.Column="0"
                        Content="开始"
                        Width="64"
                        Click="OnToggleClick"/>
                <TextBlock x:Name="SpeedLabel"
                           Grid.Column="1"
                           Text="速度 22"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="#FFEEEEEE"/>
                <Button Grid.Column="2"
                        Content="✕"
                        Width="24"
                        Height="24"
                        Click="OnCloseClick"
                        ToolTip="退出"/>
            </Grid>
            <TextBlock Text="速度"
                       Foreground="#FFEEEEEE"
                       Margin="0,10,0,0"/>
            <Slider x:Name="SpeedSlider"
                    Minimum="1"
                    Maximum="40"
                    Value="22"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="OnSpeedChanged"/>
            <TextBlock x:Name="AmplitudeLabel"
                       Text="幅度 5"
                       Foreground="#FFEEEEEE"
                       Margin="0,10,0,0"/>
            <Slider x:Name="AmplitudeSlider"
                    Minimum="1"
                    Maximum="20"
                    Value="5"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ValueChanged="OnAmplitudeChanged"/>
            <Grid Margin="0,4,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <RadioButton x:Name="DirectionDown"
                             Grid.Column="0"
                             Content="↓ 向下"
                             IsChecked="True"
                             Foreground="#FFEEEEEE"
                             Checked="OnDirectionChanged"/>
                <RadioButton x:Name="DirectionUp"
                             Grid.Column="1"
                             Content="↑ 向上"
                             Foreground="#FFEEEEEE"
                             Checked="OnDirectionChanged"/>
            </Grid>
        </StackPanel>
    </Border>
</Window>
