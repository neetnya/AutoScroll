<Window x:Class="AutoScroll.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoScroll"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="220"
        SizeToContent="Height"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        MouseLeftButtonDown="OnMouseLeftButtonDown">
    <Border x:Name="RootBorder"
            Background="{StaticResource PanelBgIdle}"
            BorderBrush="{StaticResource PanelBorderIdle}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="12">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="ToggleButton"
                        Grid.Column="0"
                        Style="{StaticResource ToggleButtonStyle}"
                        Content="开始"
                        Tag="Off"
                        Width="64"
                        Click="OnToggleClick"/>
                <TextBlock x:Name="StatusLabel"
                           Grid.Column="1"
                           Text="已停止"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource TextPrimary}"/>
                <Button Grid.Column="2"
                        Style="{StaticResource CloseButtonStyle}"
                        Content="✕"
                        Width="24"
                        Height="24"
                        Click="OnCloseClick"
                        ToolTip="退出"/>
            </Grid>
            <TextBlock x:Name="SpeedLabel"
                       Text="速度 22"
                       Foreground="{StaticResource TextPrimary}"
                       Margin="0,10,0,0"
                       ToolTip="两次滚动之间的间隔。档位越大，滚得越快。"/>
            <Slider x:Name="SpeedSlider"
                    Minimum="1"
                    Maximum="40"
                    Value="22"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    ToolTip="两次滚动之间的间隔。档位越大，滚得越快。"
                    ValueChanged="OnSpeedChanged"/>
            <StackPanel x:Name="ExtraSettings">
                <TextBlock x:Name="AmplitudeLabel"
                           Text="幅度 5"
                           Foreground="{StaticResource TextPrimary}"
                           Margin="0,10,0,0"
                           ToolTip="单次滚动跳多远。档位越大，一次跳得越远。"/>
                <Slider x:Name="AmplitudeSlider"
                        Minimum="1"
                        Maximum="20"
                        Value="5"
                        TickFrequency="1"
                        IsSnapToTickEnabled="True"
                        ToolTip="单次滚动跳多远。档位越大，一次跳得越远。"
                        ValueChanged="OnAmplitudeChanged"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="DirectionDown"
                                 Grid.Column="0"
                                 Content="↓ 向下"
                                 IsChecked="True"
                                 Checked="OnDirectionChanged"/>
                    <RadioButton x:Name="DirectionUp"
                                 Grid.Column="1"
                                 Content="↑ 向上"
                                 Checked="OnDirectionChanged"/>
                </Grid>
            </StackPanel>
            <TextBlock Margin="0,8,0,0"
                       Text="滚鼠标所在窗口"
                       FontSize="11"
                       Foreground="{StaticResource TextMuted}"
                       ToolTip="滚动会打到鼠标指针下方的窗口，请把鼠标放在要滚的内容上。"/>
        </StackPanel>
    </Border>
</Window>
